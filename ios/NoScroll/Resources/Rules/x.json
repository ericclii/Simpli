{
  "version": 1,
  "minEngine": 1,
  "services": {
    "x": {
      "match": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "authAllowList": [
        "^/i/flow/",
        "^/login",
        "^/account/"
      ],
      "surfaces": {
        "for-you": {
          "kind": "dom-remove",
          "label": "Block For You tab",
          "selectors": [
            "[role='tablist'] [role='tab']:first-child",
            "a[href='/home'][role='tab']:first-child"
          ],
          "defaultEnabled": true,
          "afterRemove": "rejustify"
        },
        "explore": {
          "kind": "route-block",
          "label": "Block Explore & Trends",
          "patterns": [
            "^/explore",
            "^/i/trends",
            "^/i/topics"
          ],
          "redirect": "/home",
          "defaultEnabled": true
        },
        "video-feed": {
          "kind": "route-block",
          "label": "Block the video feed",
          "patterns": [
            "^/i/videos",
            "^/i/immersive"
          ],
          "redirect": "/home",
          "defaultEnabled": true
        },
        "promoted": {
          "kind": "dom-remove",
          "label": "Hide promoted posts",
          "selectors": [
            "article:has([data-testid='placementTracking'])",
            "article:has(span:only-child[data-testid='promotedIndicator'])"
          ],
          "defaultEnabled": true
        },
        "who-to-follow": {
          "kind": "dom-remove",
          "label": "Hide 'Who to follow'",
          "selectors": [
            "aside[aria-label]:has(a[href='/i/connect_people'])",
            "[data-testid='UserCell']"
          ],
          "defaultEnabled": false
        },
        "grayscale": {
          "kind": "style",
          "label": "Grayscale",
          "css": "html { filter: grayscale(1) !important; }"
        }
      }
    }
  },
  "signature": "V0vnxNSuekmrUnqsLy2lOtjI3W3D69jVy4lLEH7XZF1B9o01a+bvji5ybAGcsdR5g0qoTPQF7vKJqWEDEoqRAQ=="
}
