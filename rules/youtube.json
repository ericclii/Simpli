{
  "version": 1,
  "minEngine": 1,
  "services": {
    "youtube": {
      "match": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "authAllowList": [
        "^/signin",
        "^/logout",
        "^/ServiceLogin"
      ],
      "surfaces": {
        "shorts-route": {
          "kind": "route-rewrite",
          "label": "Block Shorts",
          "pattern": "^/shorts/([A-Za-z0-9_-]+)(.*)$",
          "replacement": "/watch?v=$1",
          "source": "The single cheapest win in the product: /shorts is purely a front-end player skin. Same video, same CDN, same metadata.",
          "defaultEnabled": true
        },
        "shorts-shelf": {
          "kind": "dom-remove",
          "label": "Block Shorts shelf",
          "selectors": [
            "ytd-rich-shelf-renderer[is-shorts]",
            "ytd-reel-shelf-renderer",
            "ytm-reel-shelf-renderer",
            "grid-shelf-view-model:has(a[href^='/shorts'])",
            "ytd-rich-section-renderer:has(a[href^='/shorts'])",
            "ytm-rich-section-renderer:has(a[href^='/shorts'])",
            "ytd-video-renderer:has(a[href^='/shorts'])",
            "ytm-video-with-context-renderer:has(a[href^='/shorts'])"
          ],
          "source": "seeded from gijsdev/ublock-hide-yt-shorts (MIT)",
          "defaultEnabled": true
        },
        "shorts-nav": {
          "kind": "dom-remove",
          "label": "Remove Shorts tab",
          "selectors": [
            "ytd-mini-guide-entry-renderer:has(a[title='Shorts'])",
            "ytd-guide-entry-renderer:has(a[href='/shorts'])",
            "ytm-pivot-bar-item-renderer:has(div[aria-label='Shorts'])",
            "ytm-pivot-bar-item-renderer:has(a[href^='/shorts'])",
            "a.pivot-shorts",
            "ytm-pivot-bar-item-renderer:has(.pivot-shorts)",
            "ytm-pivot-bar-item-renderer:has(.pivot-bar-item-tab.shorts)",
            "[role='tab'][aria-label='Shorts']"
          ],
          "afterRemove": "rejustify",
          "defaultEnabled": true
        },
        "create-nav": {
          "kind": "dom-remove",
          "defaultEnabled": true,
          "label": "Remove Create tab",
          "selectors": [
            "ytm-pivot-bar-item-renderer:has([aria-label='Create'])",
            "ytd-button-renderer:has(a[href='/upload'])"
          ],
          "afterRemove": "rejustify"
        },
        "up-next": {
          "kind": "dom-remove",
          "defaultEnabled": false,
          "label": "Hide up-next & recommended",
          "selectors": [
            "ytd-watch-next-secondary-results-renderer",
            "ytm-item-section-renderer[section-identifier='related-items']",
            "#related",
            "ytd-compact-video-renderer"
          ],
          "onlyOnRoutes": [
            "^/watch"
          ],
          "source": "Required: the /shorts->/watch rewrite alone just moves the user into a different infinite loop."
        },
        "home-feed": {
          "kind": "dom-remove",
          "defaultEnabled": false,
          "label": "Block home feed",
          "selectors": [
            "ytd-rich-grid-renderer",
            "ytm-rich-grid-renderer"
          ],
          "onlyOnRoutes": [
            "^/$",
            "^/\\?"
          ]
        },
        "trending": {
          "kind": "route-block",
          "defaultEnabled": true,
          "label": "Block Trending & Explore",
          "patterns": [
            "^/feed/trending",
            "^/feed/explore"
          ],
          "redirect": "/feed/subscriptions"
        },
        "grayscale": {
          "kind": "style",
          "defaultEnabled": false,
          "label": "Grayscale",
          "css": "html { filter: grayscale(1) !important; }"
        },
        "open-app-button": {
          "kind": "dom-remove",
          "selectors": [
            "ytm-mobile-topbar-renderer ytm-button-renderer:has(a[href^='vnd.youtube:'])",
            "ytm-mobile-topbar-renderer ytm-button-renderer:has(a[href*='open_app'])"
          ],
          "suppression": "hide",
          "defaultEnabled": true,
          "source": "The top bar's \"Open App\" button links to vnd.youtube:// (YouTube's app scheme) with an open_app campaign tag, which is language-independent; seen on a signed-in m.youtube.com 2026-09-29. No label, so it is always on and not listed in Settings."
        }
      }
    }
  },
  "signature": "23oTCAf/Dgvw6q51R1G3Bn0yRVv6jCZYGmGwYyseq6whN8EsR0sxqRy0tPSOLdR9SYn/MXb6FqLasaE1LjtWCA=="
}
